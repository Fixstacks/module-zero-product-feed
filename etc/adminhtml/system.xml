<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="zero_product_feed" translate="label" type="text" sortOrder="95" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Product Feeds</label>
            <tab>zero</tab>
            <resource>Zero_ProductFeed::config</resource>
            <group id="general" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <comment><![CDATA[The store view's catalog as XML that marketplaces fetch by URL: <code>{store URL}/productfeed/rozetka</code>, <code>/productfeed/prom</code>, <code>/productfeed/hotline</code>, <code>/productfeed/google</code>. Products visible in the catalog, in stock, in the store view's language and currency; each size or color of a product is an offer of its own, grouped. A feed is built at most once an hour, and again when products change.]]></comment>
                <field id="vendor" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Brand</label>
                    <comment>For products without a manufacturer. Empty: the store's name (General > Store Information).</comment>
                </field>
            </group>
            <group id="rozetka" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Rozetka</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="prom" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Prom.ua</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="hotline" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Hotline</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="firm_id" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Firm ID</label>
                    <comment>The shop's ID in the Hotline account.</comment>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>
            <group id="google" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Google Merchant Center, Meta Catalog</label>
                <comment><![CDATA[In Merchant Center: Products > Add products > Add from a file > Enter a link to your file: <code>{store URL}/productfeed/google</code>, fetched daily. The same link works as a Meta catalog data feed (Commerce Manager > Catalog > Data sources). Shipping and tax: set in Merchant Center.]]></comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
